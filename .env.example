# Copy to .env.local and paste real values. .env.local is gitignored.
# See docs/AUTH_SETUP.md for the full local-dev walkthrough.

PUBLIC_SITE_URL=https://snooches.avalonvitality.co

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=

# Privileged Admin/staff MFA policy. These are one policy split across two
# runtimes and must be changed together in a reviewed environment release:
# - VITE_MFA_ENFORCED gates the client on Supabase's supported AAL result.
# - MFA_ENFORCED makes the standard Admin/staff role helpers and the enumerated
#   custom OS, event, and appointment-summary gates require an AAL2 token.
# Keep both false for local/demo review. Before enabling in production, verify
# named operators can enroll/challenge TOTP and retain a tested recovery path.
VITE_MFA_ENFORCED=false
MFA_ENFORCED=false

# Synthetic/local compatibility only. The legacy Qualiphy callback uses a
# static URL secret and is enabled only for explicit local development/test
# runs; preview, production, and ambiguous environments fail closed. Leave
# false; replace it with a native signed/replay-safe webhook.
QUALIPHY_LEGACY_WEBHOOK_MUTATIONS_ENABLED=false

# Production/staging live API switch. The browser flag disables demo auth in
# the shipped bundle; server functions also accept either flag for live vendor
# actions. Keep both set to the same value in Vercel environments.
VITE_AVALON_ENABLE_LIVE_API=false
AVALON_ENABLE_LIVE_API=false

# Catalog cutover gate. Keep false until the new Catalog has been imported,
# shadow-compared with the current public menu, and checkout price resolution
# has been migrated to the same Catalog rules. Once enabled, /protocols fails
# closed instead of showing legacy offerings or prices.
VITE_CATALOG_PUBLIC_CUTOVER=false

# Optional — only used when Supabase keys are absent, to gate the local
# demo roster in src/lib/useAuthStore.js.
VITE_AVALON_DEMO_AUTH=
VITE_AVALON_DEMO_PASSWORD=
VITE_AVALON_ENABLE_FIRST_PARTY_ANALYTICS=false
VITE_APP_VERSION=
VITE_SENTRY_DSN=
VITE_ADMIN_PREVIEW=
# Enables routes and operational surfaces that are exclusive to the protected
# Avalon OS beta deployment. Keep false everywhere except avalonweb-beta.
VITE_AVALON_OS_BETA=false

# Auth provider exposure. Keep false until the matching Supabase Auth provider
# is configured and `npm run test:oauth-config` passes. Disabled providers stay
# hidden in the UI so snooches never exposes broken launch paths.
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_APPLE_ENABLED=false
VITE_AUTH_PHONE_ENABLED=false
VITE_AUTH_PASSKEY_ENABLED=false

# Cognito Forms intake embed (the PHI-free front door).
# These two are PUBLIC embed identifiers, not secrets: the account key ships in
# the client bundle and is visible in any Cognito embed snippet, so there is
# nothing to leak. Safe to commit and safe to set in every Vercel environment.
# If either is unset, src/components/forms/CognitoFormEmbed.jsx fails CLOSED to
# a plain phone-number card — the front door then collects nothing at all.
VITE_COGNITO_ACCOUNT_KEY=Tj34pIQDwkyKMQlnT_qpRQ
VITE_COGNITO_INTAKE_FORM_ID=1
# Co-branded appointment form for /vitalice (Vital Ice × Avalon, form #3)
VITE_COGNITO_VITALICE_FORM_ID=3

# Stripe Checkout / webhooks.
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_EXPIRES_MINUTES=
STRIPE_WEBHOOK_MAX_BODY_BYTES=
STRIPE_WEBHOOK_PROCESSING_TIMEOUT_MS=

# Server-only Supabase service role for API writes.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Legacy fallback only; prefer SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_KEY=

# Server-only. Required for live checkout confirmation summary tokens.
# Use a random high-entropy value and set it in Vercel server envs only.
APPOINTMENT_SUMMARY_TOKEN_SECRET=

# Server-only. The /invoice contractor pay form's shared gate + token signer.
# NEVER add a VITE_ prefix to these — Vite would inline the password into the
# public bundle. scripts/launch-blocker-qa.mjs scans dist for these names.
# AVALON_INVOICE_TOKEN_SECRET: use `openssl rand -base64 32`.
AVALON_INVOICE_USER=
AVALON_INVOICE_PASSWORD=
AVALON_INVOICE_TOKEN_SECRET=

# Server-only live integrations.
AVALON_INTERNAL_API_SECRET=
ACUITY_USER_ID=
ACUITY_API_KEY=
ACUITY_DEFAULT_TYPE_ID=
ACUITY_TYPE_IV_VITAMINS=
ACUITY_TYPE_IV_NAD=
ACUITY_TYPE_IV_CBD=
ACUITY_TYPE_IM_SHOTS=
ACUITY_TYPE_MEMBERSHIP=
ACUITY_TYPE_HYDRATION=
ACUITY_TYPE_ENERGY=
ACUITY_TYPE_IMMUNITY=
ACUITY_TYPE_BEAUTY=
ACUITY_TYPE_RECOVERY=
ACUITY_TYPE_JETLAG=
ACUITY_TYPE_MYERS=
ACUITY_TYPE_HANGOVER=
VITE_ACUITY_DEFAULT_TYPE_ID=
VITE_ACUITY_TYPE_HYDRATION=
VITE_ACUITY_TYPE_MYERS=
VITE_ACUITY_TYPE_ENERGY=
VITE_ACUITY_TYPE_IMMUNITY=
VITE_ACUITY_TYPE_BEAUTY=
VITE_ACUITY_TYPE_RECOVERY=
VITE_ACUITY_TYPE_HANGOVER=
VITE_ACUITY_TYPE_JETLAG=
VITE_ACUITY_TYPE_IV_NAD=
VITE_ACUITY_TYPE_IV_CBD=
VITE_ACUITY_TYPE_IM_SHOTS=
VITE_ACUITY_TYPE_MEMBERSHIP=
VITE_ACUITY_TYPE_EVENT=
VITE_ACUITY_TYPE_EVENT_PRESALE=
ACUITY_WEBHOOK_SECRET=
ACUITY_WEBHOOK_FETCH_TIMEOUT_MS=
ACUITY_WEBHOOK_MAX_BODY_BYTES=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
AVALON_OPERATIONS_EMAIL=
# Comma-separated Avalon-domain mailboxes. Messages contain queue notices only;
# invoice details and attachments remain in the protected Finance portal.
FINANCE_NOTIFICATION_RECIPIENTS=

# RobBot3K BD research/outreach (server-only; never add VITE_ prefixes).
# Hard production gate. Keep false until migration 053 has been applied and its
# retirement ledger has been reviewed for unresolved test-derived CRM records.
# This disables every Avalon BD/RobBot read and action path, including crons and
# webhooks; it is not a browser flag and must never use a VITE_ prefix.
AVALON_BD_DATA_REVIEWED=false
# The Atlas defaults to the reviewed Netlify URL when ROBBOT3K_ATLAS_URL is
# empty. Extra allowed hosts must be explicitly listed; redirects are checked.
ROBBOT3K_ATLAS_URL=
ROBBOT3K_ATLAS_ALLOWED_HOSTS=
ROBBOT3K_CALENDLY_URL=
# Human approval plus this flag is still insufficient to send: a separately
# reviewed provider adapter and its secret must also be configured. The current
# build is provider-neutral/dry-run and never uses Resend for cold outreach.
ROBBOT3K_LIVE_SEND_ENABLED=false
# Disabled by default. Only an Avalon-owned relay may call the generic webhook;
# direct provider webhooks need provider-native signature verification.
ROBBOT3K_GENERIC_WEBHOOK_ENABLED=false
ROBBOT3K_WEBHOOK_SECRET=
# Vercel cron authentication shared by the existing secured cron handlers.
CRON_SECRET=
# HubSpot CRM. Un-BAA'd — api/_hubspot.js ships CRM-safe (identifiers +
# hospitality profile) only, guarded by scripts/no-phi-in-hubspot-qa.mjs. Set
# HUBSPOT_SYNC_ENABLED=true after the private-app token + custom properties are
# provisioned in the HubSpot portal. See docs/PHI_DATA_FLOW.md.
HUBSPOT_SYNC_ENABLED=false
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
VITE_HUBSPOT_CONFIGURED=
BOOKING_DEPOSIT_DOLLARS=
EVENT_PRESALE_WEBHOOK_SECRET=

# Optional SMS provider / Supabase auth hook.
QUO_API_KEY=
QUO_FROM_NUMBER=
# Server-only inbound webhook binding. Required with QUO_WEBHOOK_SECRET; use the
# one tenant UUID that owns the configured Quo number/account.
QUO_WEBHOOK_SECRET=
QUO_TENANT_ID=
SEND_SMS_HOOK_SECRET=
SEND_SMS_ALLOWED_COUNTRY_PREFIXES=
SEND_SMS_MAX_BODY_BYTES=

# Server-only. Persistent rate-limit backend for public lookup/auth endpoints.
# Without these, functions fall back to per-instance memory buckets.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Verification-only. Use a mailbox you control; verifiers create plus-addresses.
API_BASE_URL=https://snooches.avalonvitality.co
STRIPE_TEST_SECRET_KEY=
ACUITY_VERIFY=
VERIFY_EMAIL_ROOT=
PASSWORD_RESET_REDIRECT_TO=https://snooches.avalonvitality.co/account/new-password

# Legacy/imported Base44 placeholders. Leave blank unless a legacy surface needs them.
VITE_BASE44_APP_BASE_URL=
VITE_BASE44_APP_ID=
VITE_BASE44_FUNCTIONS_VERSION=
