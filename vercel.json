{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/expire-credits",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/post-visit-survey",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/robbot3k-morning",
      "schedule": "0,15,30,45 13,14 * * *"
    },
    {
      "path": "/api/cron/robbot3k-execute",
      "schedule": "*/30 0,1,16-23 * * *"
    },
    {
      "path": "/api/cron/nurse-invoice-notifications",
      "schedule": "*/15 * * * *"
    }
  ],
  "redirects": [
    { "source": "/mo", "destination": "https://www.avalonvitality.co/", "permanent": false },
    { "source": "/mo/", "destination": "https://www.avalonvitality.co/", "permanent": false },
    { "source": "/book", "has": [{ "type": "host", "value": "www.avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/book-now", "has": [{ "type": "host", "value": "www.avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/booking", "has": [{ "type": "host", "value": "www.avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/booking/confirmation", "has": [{ "type": "host", "value": "www.avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/checkout", "has": [{ "type": "host", "value": "www.avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/checkout/success", "has": [{ "type": "host", "value": "www.avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/custom", "has": [{ "type": "host", "value": "www.avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/book", "has": [{ "type": "host", "value": "avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/book-now", "has": [{ "type": "host", "value": "avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/booking", "has": [{ "type": "host", "value": "avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/booking/confirmation", "has": [{ "type": "host", "value": "avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/checkout", "has": [{ "type": "host", "value": "avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/checkout/success", "has": [{ "type": "host", "value": "avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/custom", "has": [{ "type": "host", "value": "avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/book", "has": [{ "type": "host", "value": "care.avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/book-now", "has": [{ "type": "host", "value": "care.avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/booking", "has": [{ "type": "host", "value": "care.avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/booking/confirmation", "has": [{ "type": "host", "value": "care.avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/checkout", "has": [{ "type": "host", "value": "care.avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/checkout/success", "has": [{ "type": "host", "value": "care.avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/custom", "has": [{ "type": "host", "value": "care.avalonvitality.co" }], "destination": "/start", "permanent": false },
    { "source": "/newsletter", "destination": "/start", "permanent": false },
    { "source": "/waitlist", "destination": "/start", "permanent": false },
    { "source": "/organizer/login", "destination": "/login?portal=organizer", "permanent": false },
    { "source": "/products/cbd/:path*", "has": [{ "type": "host", "value": "www.avalonvitality.co" }], "destination": "/protocols", "permanent": true },
    { "source": "/products/cbd/:path*", "has": [{ "type": "host", "value": "avalonvitality.co" }], "destination": "/protocols", "permanent": true },
    { "source": "/services/cbd", "has": [{ "type": "host", "value": "www.avalonvitality.co" }], "destination": "/protocols", "permanent": true },
    { "source": "/services/cbd", "has": [{ "type": "host", "value": "avalonvitality.co" }], "destination": "/protocols", "permanent": true },
    { "source": "/therapies/cbd", "has": [{ "type": "host", "value": "www.avalonvitality.co" }], "destination": "/protocols", "permanent": true },
    { "source": "/therapies/cbd", "has": [{ "type": "host", "value": "avalonvitality.co" }], "destination": "/protocols", "permanent": true },
    { "source": "/therapies/cbd-iv", "has": [{ "type": "host", "value": "www.avalonvitality.co" }], "destination": "/protocols", "permanent": true },
    { "source": "/therapies/cbd-iv", "has": [{ "type": "host", "value": "avalonvitality.co" }], "destination": "/protocols", "permanent": true },
    { "source": "/cbd-iv-therapy-bay-area", "has": [{ "type": "host", "value": "www.avalonvitality.co" }], "destination": "/protocols", "permanent": true },
    { "source": "/cbd-iv-therapy-bay-area", "has": [{ "type": "host", "value": "avalonvitality.co" }], "destination": "/protocols", "permanent": true },
    { "source": "/events/cannabis-ce", "has": [{ "type": "host", "value": "www.avalonvitality.co" }], "destination": "/protocols", "permanent": true },
    { "source": "/events/cannabis-ce", "has": [{ "type": "host", "value": "avalonvitality.co" }], "destination": "/protocols", "permanent": true },
    { "source": "/learn/:slug(.*cbd.*)", "has": [{ "type": "host", "value": "www.avalonvitality.co" }], "destination": "/protocols", "permanent": true },
    { "source": "/learn/:slug(.*cbd.*)", "has": [{ "type": "host", "value": "avalonvitality.co" }], "destination": "/protocols", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/b2b",
      "destination": "/b2b.html"
    },
    {
      "source": "/b2b/",
      "destination": "/b2b.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(account|account/.*|admin|admin/.*|apply|athlete|auth|auth/.*|b2b/thank-you|book|book-now|booking|booking/.*|careers|checkout|checkout/.*|cookie-policy|cookies|corporate|custom|dashboard|events|events/.*|faq|forgot|forgot-password|hangover|hipaa-notice|hotel|ingredients|invite|invite/.*|invoice|iv-therapy|jet-lag|kiosk|launches|launches/.*|learn|learn/.*|liability-waiver|locations|locations/.*|login|medical-direction|members|members/.*|membership|menu|notice-of-privacy-practices|nurse|nurse-delivery|nurse-login|nurses|order|organizer|organizer/.*|our-story|our-team|partners|plan|plan-checkout|plans|plans/checkout|platform|presale|presale/.*|press|pricing|privacy|privacy-policy|product-disclaimer|products/.*|protocols|provider|provider/.*|provider/login|providers|redeem|review|safety|service-area|services|services/.*|sign-in|signin|start|start/.*|store|store/.*|subscribe|subscription|support|team|telehealth-disclaimer|terms|terms-and-conditions|terms-of-service|therapies/.*|trips|trips/.*|vitalice|waiver)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(start|vitalice)",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.cognitoforms.com>; rel=preconnect, <https://static.cognitoforms.com>; rel=preconnect, <https://www.cognitoforms.com/f/seamless.js>; rel=preload; as=script"
        }
      ]
    },
    {
      "source": "/bags/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, OPTIONS"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "snooches.avalonvitality.co"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "beta.avalonvitality.co"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "care.avalonvitality.co"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), interest-cohort=(), payment=(self \"https://checkout.stripe.com\" \"https://js.stripe.com\")"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-eval' 'sha256-WGmrSpS66Wo6wmLYDmC+BgeI/xE1TXtjxfi37LQDe/U=' https://fonts.googleapis.com https://js.stripe.com https://translate.google.com https://vercel.live https://www.cognitoforms.com https://static.cognitoforms.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://translate.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.resend.com https://api.stripe.com https://acuityscheduling.com https://translate.googleapis.com https://translate.google.com https://*.supabase.co wss://*.supabase.co https://vercel.live wss://vercel.live https://www.cognitoforms.com https://static.cognitoforms.com; frame-src https://js.stripe.com https://hooks.stripe.com https://checkout.stripe.com https://translate.google.com https://vercel.live https://www.cognitoforms.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/|favicon|.*\\.(?:js|css|png|jpg|jpeg|webp|svg|ico|json|xml|txt|woff|woff2|mp4)).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
